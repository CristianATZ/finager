<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Finager" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.Finager.Starting" parent="Theme.SplashScreen">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="windowSplashScreenBackground">@color/background_splashscreen</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Finager</item>
    </style>
</resources>